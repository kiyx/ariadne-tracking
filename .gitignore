# ═══════════════════════════════════════════════════════════
# .gitignore — Ariadne Tracking
# ═══════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Test & Coverage ──────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.pytest_cache/
.hypothesis/
coverage.xml

# ── Type checking & Linting ──────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Ambienti virtuali ────────────────────────────────────
.env
.envrc
.venv
venv/
env/
ariadne_env/

# ── IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*~
*.bak
*.swp

# ── Jupyter / IPython ────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
profile_default/

# ── Modelli AI & Pesi ────────────────────────────────────
# File pesanti, versionati con DVC o scaricati separatamente.
*.pt
*.pth
*.pth.tar
*.onnx
*.tflite
*.pb
*.engine
*.trt
weights/
checkpoints/
models/

# Eccezione: codice sorgente Simple-CCReID necessario a runtime
# (config modello, backbone C2DResNet50, utilities, symlink top-level).
# Git richiede di un-ignorare ogni livello di directory padre.
!models/
models/*
!models/simple_ccreid/
models/simple_ccreid/*
!models/simple_ccreid/configs/
models/simple_ccreid/configs/*
!models/simple_ccreid/configs/default_vid.py
!models/simple_ccreid/models/
models/simple_ccreid/models/*
!models/simple_ccreid/models/__init__.py
!models/simple_ccreid/models/vid_resnet.py
!models/simple_ccreid/models/classifier.py
!models/simple_ccreid/models/img_resnet.py
!models/simple_ccreid/models/utils/
models/simple_ccreid/models/utils/*
!models/simple_ccreid/models/utils/*.py
# Symlink top-level (puntano a simple_ccreid/models/*)
!models/vid_resnet.py
!models/classifier.py
!models/img_resnet.py
!models/utils

# ── Dataset ──────────────────────────────────────────────
# Video raw (mantieni solo i file con gli URL)
data/raw/videos/*
!data/raw/videos/mevid-v1-video-URLS.txt
!data/raw/videos/mevid-subset-urls.txt

# ROI estratte, embedding e report intermedi
data/processed/

# Annotazioni e crop GT MEVID (scaricati separatamente)
data/mevid-v1-annotation-data/
data/mevid-v1-bbox-test/

# Altre directory dati
datasets/
test_videos/
gallery/

# ── Log & Output ─────────────────────────────────────────
output/logs/
output/*.json
*.log
runs/
wandb/
logs/
cache/
backups/

# RooCode
.roomodes
.roo/
.clinerules

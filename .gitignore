# ═══════════════════════════════════════════════════════════
# .gitignore — Ariadne Tracking
# ═══════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Test & Coverage ──────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.pytest_cache/
.hypothesis/
coverage.xml

# ── Type checking & Linting ──────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Ambienti virtuali ────────────────────────────────────
.env
.envrc
.venv
venv/
env/
ariadne_env/

# ── IDE ──────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp

# ── Jupyter / IPython ────────────────────────────────────
.ipynb_checkpoints/
profile_default/

# ── 1. Modelli AI & Pesi ─────────────────────────────────
# File pesanti, versionati con DVC o scaricati separatamente.
*.pt
*.pth
*.pth.tar
*.onnx
*.tflite
*.pb
*.engine
*.trt
weights/
checkpoints/
models/

# ── 2. Dataset e Media ───────────────────────────────────
# Video raw (scaricati con 00_setup_dataset.py)
data/raw/videos/*.avi
data/raw/videos/*.mp4
data/raw/videos/*.mov
data/raw/videos/*.mkv
data/raw/videos/*.webm

# ROI estratte (generate dal Modulo 1)
data/processed/extracted_rois/*/
data/processed/extracted_rois/*.json

# Altre directory dati
datasets/
test_videos/
gallery/

# ── 3. Log & Output ─────────────────────────────────────
output/logs/
runs/
wandb/
logs/
cache/
*.log

# ── 4. File da mantenere ────────────────────
# URL dei video
!data/raw/videos/mevid-v1-video-URLS.txt
!data/raw/videos/mevid-subset-urls.txt
